# Flight Hacker configuration. Copy to .env.local; never commit real secrets.
# All variables are optional. Secrets are read on the server only.

# --- Data sources -----------------------------------------------------------
# Demo network with fictional airlines over real airports, labelled "Demo" everywhere.
# Turn it off in production once a live provider is configured.
ENABLE_DEMO_PROVIDERS=true
# Simulated demo latency range in milliseconds (min-max).
MOCK_LATENCY_MS=5-40

# Duffel Flights API. Test tokens (duffel_test_...) return test-mode offers, labelled "Test mode";
# live tokens return real fares. Booking (Orders API + payments) is not implemented.
DUFFEL_ACCESS_TOKEN=
DUFFEL_MAX_CALLS_PER_SEARCH=12
DUFFEL_MAX_CONCURRENCY=2
DUFFEL_SUPPLIER_TIMEOUT_MS=15000

# --- Persistence (optional) -------------------------------------------------
# PostgreSQL for the shared provider-response cache. Without it, an in-memory cache is used.
# Example: postgresql://user:password@localhost:5432/flight_hacker?schema=public
DATABASE_URL=

# --- Behaviour ---------------------------------------------------------------
# bundled (approximate, offline) or ecb (daily ECB reference rates, cached 12 h)
FX_SOURCE=bundled
SEARCH_DEADLINE_MS=25000
MAX_CANDIDATES=250
RATE_LIMIT_SEARCH_PER_MIN=12
RATE_LIMIT_API_PER_MIN=120
# Read the client IP from X-Forwarded-For (hashed; used for rate limiting only).
TRUST_PROXY=true
# debug | info | warn | error | silent
LOG_LEVEL=info
# Demos/E2E only: lets ?simulate=fail:<provider-id> force a provider outage.
ALLOW_FAULT_INJECTION=false
